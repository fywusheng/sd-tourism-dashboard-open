# 开发环境配置
VITE_NODE_ENV=development

# API 基础地址 (开发环境使用代理，所以使用相对路径)
VITE_API_BASE_URL=/api

# 旅游数据 API 地址
VITE_TOURISM_API_BASE_URL=/tourism-api

# 文件上传地址
VITE_UPLOAD_BASE_URL=/upload

# 是否开启 Mock 数据
VITE_USE_MOCK=false

# 应用标题
VITE_APP_TITLE=山东省旅游业智能监控平台

# 后端服务地址 (仅用于代理配置参考)
VITE_BACKEND_URL=http://localhost:3000
